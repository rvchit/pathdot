# ---- cello backend ----
PORT=4001

# local (default, zero AWS) | s3
STORAGE_MODE=local

# Local mode paths (relative to cello/backend, or absolute)
TILES_DIR=../../tiles
UPLOAD_DIR=../../data/slides
DATA_DIR=../../data

# FastAPI inference service; everything under /ml/* is proxied here
ML_SERVICE_URL=http://localhost:8008

# Comma-separated origins, or * for all
CORS_ORIGIN=*
JSON_BODY_LIMIT=50mb
MAX_UPLOAD_MB=2048

# ---- s3 mode only ----
# AWS_REGION=us-east-2
# AWS_ACCESS_KEY=
# AWS_SECRET_KEY=
# S3_BUCKET=cello-bucket            # raw slide uploads
# S3_TILES_BUCKET=cello-tiles       # DZI pyramids

# ---- optional (not wired yet; see commentsRoute.ts for how to switch to Prisma) ----
# DATABASE_URL=postgresql://user:pass@localhost:5432/cello
