# Fireworks (baseline VLM + fine-tuning). https://fireworks.ai/account/api-keys
FIREWORKS_API_KEY=
FIREWORKS_ACCOUNT_ID=
# Hugging Face token (needed for gated encoders: UNI, CONCH, Virchow2, H-optimus-0)
HF_TOKEN=
# Optional: closed frontier baseline via Anthropic
ANTHROPIC_API_KEY=
# Optional overrides
PATHFRONTIER_DATA_DIR=data
PATHFRONTIER_CACHE_DIR=cache
PATHFRONTIER_RESULTS_DIR=results
